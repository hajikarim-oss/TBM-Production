{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/videofolio build && mkdir -p dist && cp -r artifacts/videofolio/dist/* dist/",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/studio/assets/:match*", "destination": "/studio/assets/:match*" },
    { "source": "/studio/brands/:match*", "destination": "/studio/brands/:match*" },
    { "source": "/studio/(.*)", "destination": "/studio/index.html" }
  ]
}
