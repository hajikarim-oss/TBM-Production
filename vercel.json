{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/videofolio build",
  "outputDirectory": "artifacts/videofolio/dist/public",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/studio/assets/:match*", "destination": "/studio/assets/:match*" },
    { "source": "/studio/brands/:match*", "destination": "/studio/brands/:match*" },
    { "source": "/studio/(.*)", "destination": "/studio/index.html" }
  ]
}
