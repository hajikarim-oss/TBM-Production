{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/videofolio build",
  "outputDirectory": "artifacts/videofolio/dist",
  "rewrites": [
    {
      "source": "/studio/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/studio/entries/(.*)",
      "destination": "/entries/$1"
    },
    {
      "source": "/studio/chunks/(.*)",
      "destination": "/chunks/$1"
    },
    {
      "source": "/studio/brands/(.*)",
      "destination": "/brands/$1"
    },
    {
      "source": "/studio/fonts/(.*)",
      "destination": "/fonts/$1"
    },
    {
      "source": "/studio/videos/(.*)",
      "destination": "/videos/$1"
    },
    {
      "source": "/studio/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/studio/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/studio/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)chunks/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)entries/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)brands/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/(.*)videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/(.*).woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
