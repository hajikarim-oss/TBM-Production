{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/videofolio build; mkdir -p dist; cp -r artifacts/videofolio/dist/* dist/",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/studio/assets/:match*", "destination": "/assets/:match*" },
    { "source": "/studio/brands/:match*", "destination": "/brands/:match*" },
    { "source": "/studio/:match*", "destination": "/index.html" }
  ]
}
